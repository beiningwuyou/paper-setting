PAPER_SETTING_MAX_UPLOAD_BYTES=52428800
PAPER_SETTING_MAX_UNCOMPRESSED_BYTES=524288000
PAPER_SETTING_MAX_ZIP_ENTRIES=20000
PAPER_SETTING_API_RATE_LIMIT_PER_MINUTE=240
PAPER_SETTING_LOG_LEVEL=INFO
PAPER_SETTING_AGENT_AUDIT_ENABLED=true
