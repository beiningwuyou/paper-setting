PAPER_SETTING_PORT=8765
PAPER_SETTING_DATABASE_URL=sqlite:///./data/paper-setting.db
PAPER_SETTING_DATA_DIR=./data
PAPER_SETTING_ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:8765"]
